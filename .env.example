# Copy to .env.local for `npm run dev`, and add the same keys in Vercel → Project → Settings → Environment Variables.

# From https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Inbox that receives order notes (comma-separate for several)
ENQUIRY_TO=you@example.com

# Sender. Must be on a domain you verified in Resend (resend.com/domains).
# Leave unset to use Resend's test sender, which only delivers to your own Resend account email.
# ENQUIRY_FROM=Glistening <orders@yourdomain.co.za>

# "true" emails the customer a copy too (needs ENQUIRY_FROM on a verified domain)
# SEND_CONFIRMATION=true
